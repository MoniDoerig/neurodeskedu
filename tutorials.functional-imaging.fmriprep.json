menus to first open the neurodesk options","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"HCVdw547Qg"}],"key":"ZrM6QRiJ2l"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"image","url":"/edu/build/neurodesk_menu-4d4bc6f002ef7cc0ad12877658898498.png","alt":"neurodesk_menu","title":"neurodesk_menu","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"jaHOK0tvoG","urlSource":"/static/tutorials/functional_imaging/fmriprep/neurodesk_menu.png"},{"type":"text","value":" ","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"K4ta24FQLk"},{"type":"comment","value":" ![filename without extension](/static/tutorials/functional_imaging/subfolder_name/filename.png '[filename without extension')  ","key":"Rqr5F0vGla"}],"key":"qr7WmCCOUi"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"and then select fMRIPrep. Note that the latest version will be the lowest on the dropdown list:","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"cykMmWLtNP"}],"key":"UottSzG89a"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"image","url":"/edu/build/open_fmriprep-bcbb29329e3d5de05ea731f91962fb58.png","alt":"open_fmriprep","title":"open_fmriprep","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"F2HaupYKD3","urlSource":"/static/tutorials/functional_imaging/fmriprep/open_fmriprep.png"},{"type":"text","value":" ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"hNdTIsO7Jw"},{"type":"comment","value":" ![filename without extension](/static/tutorials/functional_imaging/subfolder_name/filename.png '[filename without extension')  ","key":"etzCcwiUs4"}],"key":"OmUtC2TQzU"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"This will open a terminal window where fMRIPrep is ready and waiting at your fingertips - woohoo!","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"LMSgNiwFON"}],"key":"QnGvcCZ802"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"image","url":"/edu/build/fmriprep_bash-88bbb5fe51c9c93d10ddfc7631a5ea87.png","alt":"fmriprep_bash","title":"fmriprep_bash","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"pMSAC8ie9A","urlSource":"/static/tutorials/functional_imaging/fmriprep/fmriprep_bash.png"},{"type":"text","value":" ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"Zu9PqU9NVt"},{"type":"comment","value":" ![filename without extension](/static/tutorials/functional_imaging/subfolder_name/filename.png '[filename without extension')  ","key":"f86TjaPdbb"}],"key":"F5IWT7BsLC"},{"type":"heading","depth":3,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Setting up fmriprep command","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"RJDqgd4GY0"}],"identifier":"setting-up-fmriprep-command","label":"Setting up fmriprep command","html_id":"setting-up-fmriprep-command","implicit":true,"key":"mhUm0xqT5Z"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"You can now enter your fmriprep command straight into the command line in the newly opened terminal. Here is a quick guide to the command I have used with the options I have found most useful. Note that fMRIPrep requests the path to the freesurfer license file, which should be somewhere in your system for neurodesk to read - e.g. in ‘neurodesktop-storage’.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"w0dC0dqpXU"}],"key":"oJVYEh1BGz"},{"type":"code","lang":"bash","value":"\nexport ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=6 # specify the number of threads you want to use\n\nfmriprep /path/to/your/data \\ # this is the top level of your data folder\n         /path/to/your/data/derivatives \\ # where you want fmriprep output to be saved\n         participant \\ # this tells fmriprep to analyse at the participant level\n         --fs-license-file /path/to/your/freesurfer.txt \\ # where the freesurfer license file is\n         --output-spaces T1w MNI152NLin2009cAsym fsaverage fsnative \\ \n         --participant-label 01 \\ # put what ever participant labels you want to analyse\n         --nprocs 6 --mem 10000 \\ # fmriprep can be greedy on the hpc, make sure it is not\n         --skip_bids_validation \\ # its normally fine to skip this but do make sure your data are BIDS enough\n         -v # be verbal fmriprep, tell me what you are doing","position":{"start":{"line":84,"column":1},"end":{"line":97,"column":1}},"key":"vuzt9Mss0l"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Then hit return and fMRIPrep should now be merrily working away on your data :)","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"VpeaktiANH"}],"key":"vsLau3gS6A"},{"type":"thematicBreak","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"Cp2X36XVUJ"},{"type":"heading","depth":3,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"fQQMKidZqu"}],"identifier":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","label":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","html_id":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","implicit":true,"key":"dqzhF3Rmze"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":106,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":106,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"If fmriprep hangs it could well be that you are out of disk space. Sometimes this is because fmriprep created a work directory in your home folder which is often limited on the HPC. Make sure fmriprep knows to use a work drectory in your scratch. you can specify this in the fmriprep command by using -w /path/to/the/work/directory/you/made","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"RuYsRaOel4"}],"key":"f3kC0jDjoK"}],"key":"THcKGJsy9M"},{"type":"listItem","spread":true,"position":{"start":{"line":108,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"I learned the following from TomCat (@thomshaw92) - fMRIPrep can get confused between subjects when run in parallel. Parallelise with caution.","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"Yw5N1tZUYj"}],"key":"S9ETI1Ym0k"}],"key":"lAnjFy4JT6"},{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"If running on a HPC, make sure to set the processor and memory limits, if not your job will get killed because it hogs all the resources.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"SoekzgtvzO"}],"key":"h4WJlHtjM5"}],"key":"FDDrzOwxhj"},{"type":"listItem","spread":true,"position":{"start":{"line":112,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Viewing fMRIprep HTML Outputs: Do not view these files in a browser within Neurodesktop using the RDP protocol. The HTML animations break RDP compression.\nRecommended Alternatives:","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"Dzewy12vam"}],"key":"QNWrm3WToV"}],"key":"SoDwpPDX9e"}],"key":"Tmr38iiOJ1"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":114,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"JupyterLab (Best Performance): Open the reports directly using the JupyterLab file browser.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"EpbqW4spqZ"}],"key":"HPlHU23H9b"}],"key":"DrumWIo12q"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"VNC Protocol: If you prefer a full Linux desktop environment, connect via VNC instead of RDP.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"Sce1nxmd5j"}],"key":"EZMDwITZNy"}],"key":"RU3rtEVpVj"}],"key":"G9Wb3GulNG"}],"key":"zD6woZNHro"}],"key":"QVdyR5qFPy"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Connectome Workbench","url":"/tutorials/functional-imaging/connectomeworkbench","group":"Neurodesk"},"next":{"title":"Using mriqc with neurodesk on HPC","url":"/tutorials/functional-imaging/mriqc","group":"Neurodesk"}}},"domain":"http://localhost:3000"}