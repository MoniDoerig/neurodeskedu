:75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"This will open a terminal window where fMRIPrep is ready and waiting at your fingertips - woohoo!","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"TwkPTVNOp4"}],"key":"ImBRVntsKR"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"image","url":"/edu/build/fmriprep_bash-000935393a3537d20a0d15f04a584933.png","alt":"fmriprep_bash","title":"fmriprep_bash","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"ALng1St9if","urlSource":"/static/tutorials/functional_imaging/fmriprep/fmriprep_bash.png"},{"type":"text","value":" ","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"iwSkVERr3V"},{"type":"comment","value":" ![filename without extension](/static/tutorials/functional_imaging/subfolder_name/filename.png '[filename without extension')  ","key":"Sv8zbBG1xQ"}],"key":"GxVSMVrQcC"},{"type":"heading","depth":3,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Setting up fmriprep command","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"L2j1ynXJa5"}],"identifier":"setting-up-fmriprep-command","label":"Setting up fmriprep command","html_id":"setting-up-fmriprep-command","implicit":true,"key":"GWhgVEniLF"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"You can now enter your fmriprep command straight into the command line in the newly opened terminal. Here is a quick guide to the command I have used with the options I have found most useful. Note that fMRIPrep requests the path to the freesurfer license file, which should be somewhere in your system for neurodesk to read - e.g. in ‘neurodesktop-storage’.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"MNHl8mpVRf"}],"key":"weZtRqLxgt"},{"type":"code","lang":"bash","value":"\nexport ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=6 # specify the number of threads you want to use\n\nfmriprep /path/to/your/data \\ # this is the top level of your data folder\n         /path/to/your/data/derivatives \\ # where you want fmriprep output to be saved\n         participant \\ # this tells fmriprep to analyse at the participant level\n         --fs-license-file /path/to/your/freesurfer.txt \\ # where the freesurfer license file is\n         --output-spaces T1w MNI152NLin2009cAsym fsaverage fsnative \\ \n         --participant-label 01 \\ # put what ever participant labels you want to analyse\n         --nprocs 6 --mem 10000 \\ # fmriprep can be greedy on the hpc, make sure it is not\n         --skip_bids_validation \\ # its normally fine to skip this but do make sure your data are BIDS enough\n         -v # be verbal fmriprep, tell me what you are doing","position":{"start":{"line":84,"column":1},"end":{"line":97,"column":1}},"key":"TiNzro1VzD"},{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Then hit return and fMRIPrep should now be merrily working away on your data :)","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"At88lS87Hd"}],"key":"GUjo2YLyTQ"},{"type":"thematicBreak","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"mzwms9Uc8u"},{"type":"heading","depth":3,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"ryBdWZAV26"}],"identifier":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","label":"Some common pitfalls I have learned from my mistakes (and sometimes from others)","html_id":"some-common-pitfalls-i-have-learned-from-my-mistakes-and-sometimes-from-others","implicit":true,"key":"oxnfLFNyYu"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":106,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":106,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"If fmriprep hangs it could well be that you are out of disk space. Sometimes this is because fmriprep created a work directory in your home folder which is often limited on the HPC. Make sure fmriprep knows to use a work drectory in your scratch. you can specify this in the fmriprep command by using -w /path/to/the/work/directory/you/made","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"Aavt6xA7W0"}],"key":"hOlIjqvQNH"}],"key":"SbfSFYBr81"},{"type":"listItem","spread":true,"position":{"start":{"line":108,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"I learned the following from TomCat (@thomshaw92) - fMRIPrep can get confused between subjects when run in parallel. Parallelise with caution.","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"yJQjeAMfAn"}],"key":"UHWTlbQtFw"}],"key":"U5td5qShvp"},{"type":"listItem","spread":true,"position":{"start":{"line":110,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"If running on a HPC, make sure to set the processor and memory limits, if not your job will get killed because it hogs all the resources.","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"lUM4OVcLz2"}],"key":"MUUKBWMMAZ"}],"key":"Hc5KUmPsZi"},{"type":"listItem","spread":true,"position":{"start":{"line":112,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Viewing fMRIprep HTML Outputs: Do not view these files in a browser within Neurodesktop using the RDP protocol. The HTML animations break RDP compression.\nRecommended Alternatives:","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"ajiiuJdYLV"}],"key":"DdXzeZZBur"}],"key":"ed1k92GeSM"}],"key":"Id02lEyTXB"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":114,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"JupyterLab (Best Performance): Open the reports directly using the JupyterLab file browser.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"gsSt0qNsOM"}],"key":"NDDom7pwXL"}],"key":"EmQa1k1fuP"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"VNC Protocol: If you prefer a full Linux desktop environment, connect via VNC instead of RDP.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"IC0AGk5lZN"}],"key":"ZCLWOLEZR6"}],"key":"lGM2oX9gMl"}],"key":"u5WEiAQhif"}],"key":"dPkrfakh4Y"}],"key":"WG4Ss51lXt"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Connectome Workbench","url":"/tutorials/functional-imaging/connectomeworkbench","group":"Neurodesk"},"next":{"title":"Using mriqc with neurodesk on HPC","url":"/tutorials/functional-imaging/mriqc","group":"Neurodesk"}}},"domain":"http://localhost:3000"}