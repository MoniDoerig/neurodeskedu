line":75,"column":1}},"children":[{"type":"image","url":"/edu/build/open_mriqc-fa3affec1af8adbcdadac7db8e461a91.png","alt":"open_mriqc","title":"open_mriqc","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"mv9nuaCRaq","urlSource":"/static/tutorials/functional_imaging/mriqc/open_mriqc.png"},{"type":"text","value":" ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"wk2YeBqPiI"},{"type":"comment","value":" ![filename without extension](/subfolder_name/filename.png '[filename without extension')  ","key":"wRcXJVmfMW"}],"key":"x8lGQbwaPz"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"This will open a terminal window where MRIQC is ready and waiting at your fingertips - woohoo!","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"EtQ4gXatGe"}],"key":"lyMjMSB4wD"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"image","url":"/edu/build/mriqc_bash-9166b2088e3583295fe09cf5bc2c9609.png","alt":"mriqc_bash","title":"mriqc_bash","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"mbGXT32Z7R","urlSource":"/static/tutorials/functional_imaging/mriqc/mriqc_bash.png"},{"type":"text","value":" ","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"eZw8wZogO4"},{"type":"comment","value":" ![filename without extension](/subfolder_name/filename.png '[filename without extension')  ","key":"WsgWpIHtdH"}],"key":"o4OU4Jo7PJ"},{"type":"heading","depth":3,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Setting up mriqc command","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"tSJ0vtowiF"}],"identifier":"setting-up-mriqc-command","label":"Setting up mriqc command","html_id":"setting-up-mriqc-command","implicit":true,"key":"SABnNCP7jb"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"You can now enter the following mriqc commands straight into the command line in the newly opened terminal window.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"WM6OnhEUR2"}],"key":"Orkl61bO7G"},{"type":"code","lang":"go","value":"\nexport ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=6 # specify the number of threads you want to use\n\nmriqc /path/to/your/data \\ # this is the top level of your data folder\n         /path/to/your/data/derivatives \\ # where you want mriqc output to be saved\n         participant \\ # this tells mriqc to analyse at the participant level\n         --participant-label 01 \\ # put what ever participant labels you want to analyse\n         --work-dir /path/to/work/directory \\ #useful to specify so your home directory definitely does not get clogged\n         --nprocs 6 --mem_gb 10000 \\ # mriqc can be greedy on the hpc, make sure it is not\n         -v # be verbal mriqc, tell me what you are doing","position":{"start":{"line":85,"column":1},"end":{"line":96,"column":1}},"key":"fsmSTS52qg"},{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"Note that above I have set the processor and memory limits. This is because I was in this case running on an HPC, and I used those commands to stop MRIQC from hogging all the resources. You may want to skip those inputs if you’re running MRIQC locally.","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"gIU8LVyhpH"}],"key":"tJ96SitjK9"},{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"OR: if you have run all the participants and you just want the group level report, use these mriqc commands instead:","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"cD0KvlMRBj"}],"key":"CyFzmXEZKx"},{"type":"code","lang":"","value":"mriqc /path/to/your/data \\ # this is the top level of your data folder\n         /path/to/your/data/derivatives \\ # where you want mriqc output to be saved. As you are running the group level analysis this folder should be prepopulated with the results of the participant level analysis\n         group \\ # this tells mriqc to agive you the group report\n         -w /path/to/work/directory \\ #useful to specify so your home directory definitely does not get clogged\n         --nprocs 6 --mem_gb 10000 \\ # mriqc can be greedy on the hpc, make sure it is not\n         -v # be verbal mriqc, tell me what you are doing","position":{"start":{"line":103,"column":1},"end":{"line":110,"column":1}},"key":"GMddp9rfZd"},{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Hit enter, and mriqc should now be merrily working away on your data :)","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"IMJT4TXQB0"}],"key":"pb4pyYKroo"}],"key":"ZavgP6Bw8q"}],"key":"K93TAoHdBJ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Using fmriprep with neurodesk on an HPC","url":"/tutorials/functional-imaging/fmriprep","group":"Neurodesk"},"next":{"title":"PhysIO","url":"/tutorials/functional-imaging/physio","group":"Neurodesk"}}},"domain":"http://localhost:3000"}